{
  "name": "my-app",
  "version": "0.0.1",
  "description": "My App Template",
  "type": "module",
  "scripts": {
    "test": "jest",
    "cli": "tsx src/cli/bin/cli.ts",
    "tui": "tsx src/tui/index.tsx",
    "start": "nodemon --config nodemon.json",
    "postinstall": "scripts/postinstall.sh",
    "db:migrate": "node --import tsx scripts/db/migrate.ts latest",
    "db:migrate:up": "node --import tsx scripts/db/migrate.ts up",
    "db:migrate:down": "node --import tsx scripts/db/migrate.ts down",
    "db:migrate:create": "node --import tsx scripts/db/create-migration.ts",
    "db:reset": "node --import tsx scripts/db/migrate.ts reset",
    "db:codegen": "kysely-codegen --url ${DB_PATH:-jobs.db}",
    "db:schema-review": "node --import tsx scripts/db/generate-schema-review.ts",
    "sql": "litecli ${DB_PATH:-jobs.db}"
  },
  "repository": {},
  "keywords": [],
  "author": "Yu Li",
  "license": "MIT",
  "bugs": {},
  "homepage": "",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@openrouter/sdk": "^0.12.35",
    "@valibot/to-json-schema": "^1.7.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "ink": "^6.8.0",
    "kysely": "^0.28.17",
    "p-limit": "^7.3.0",
    "patchright": "^1.59.4",
    "react": "^19.1.7",
    "uuidv7": "^1.2.1",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.17",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild-jest-fixed": "^0.5.2",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-testing-library": "^7.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.20.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3"
  }
}
