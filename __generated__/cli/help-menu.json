{
  "name": "jobfinder",
  "description": "CLI for python-jobspy",
  "usage": "[options] [command]",
  "commands": [
    {
      "name": "scrape",
      "description": "Scrape jobs via python-jobspy",
      "usage": "[options]",
      "options": [
        {
          "flags": "-s, --site <site...>",
          "description": "Sites to scrape",
          "required": true,
          "variadic": true,
          "choices": [
            "linkedin",
            "indeed",
            "zip_recruiter",
            "glassdoor",
            "google",
            "bayt",
            "naukri",
            "bdjobs"
          ],
          "default": ["indeed"]
        },
        {
          "flags": "-q, --search <term>",
          "description": "Search term",
          "required": true
        },
        {
          "flags": "--google-search <term>",
          "description": "Google natural-language search term",
          "required": true
        },
        {
          "flags": "-l, --location <location>",
          "description": "Location",
          "required": true
        },
        {
          "flags": "-d, --distance <miles>",
          "description": "Distance in miles",
          "required": true,
          "default": "50"
        },
        {
          "flags": "--remote",
          "description": "Remote only"
        },
        {
          "flags": "--job-type <type>",
          "description": "Job type",
          "required": true,
          "choices": [
            "fulltime",
            "parttime",
            "contract",
            "temporary",
            "internship",
            "perdiem",
            "nights",
            "other",
            "summer",
            "volunteer"
          ]
        },
        {
          "flags": "--easy-apply",
          "description": "LinkedIn easy-apply only"
        },
        {
          "flags": "-n, --results <count>",
          "description": "Results wanted per site",
          "required": true,
          "default": "15"
        },
        {
          "flags": "--country <country>",
          "description": "country_indeed (e.g. usa, canada)",
          "required": true,
          "default": "usa"
        },
        {
          "flags": "--proxy <proxy...>",
          "description": "Proxy URL (repeatable)",
          "required": true,
          "variadic": true
        },
        {
          "flags": "--ca-cert <path>",
          "description": "CA cert path",
          "required": true
        },
        {
          "flags": "--description-format <fmt>",
          "description": "Description format",
          "required": true,
          "choices": ["markdown", "html"]
        },
        {
          "flags": "--linkedin-fetch-description",
          "description": "Fetch full LinkedIn descriptions"
        },
        {
          "flags": "--linkedin-company-id <id...>",
          "description": "LinkedIn company IDs to filter",
          "required": true,
          "variadic": true
        },
        {
          "flags": "--offset <n>",
          "description": "Pagination offset",
          "required": true
        },
        {
          "flags": "--hours-old <hours>",
          "description": "Only jobs newer than N hours",
          "required": true
        },
        {
          "flags": "--enforce-annual-salary",
          "description": "Convert salaries to annual"
        },
        {
          "flags": "--verbose <level>",
          "description": "Verbosity 0|1|2",
          "required": true,
          "default": "0"
        },
        {
          "flags": "--user-agent <ua>",
          "description": "User-Agent override",
          "required": true
        },
        {
          "flags": "-f, --format <format>",
          "description": "Output format",
          "required": true,
          "choices": ["json", "csv"],
          "default": "json"
        },
        {
          "flags": "-o, --output <file>",
          "description": "Write to file instead of stdout",
          "required": true
        }
      ]
    },
    {
      "name": "sites",
      "description": "List supported job sites and job types",
      "usage": "[options]"
    },
    {
      "name": "pipeline",
      "description": "Pipeline operations",
      "usage": "[options] [command]",
      "commands": [
        {
          "name": "seeding",
          "description": "Seed SourceSeed table from seeds/interests.md via an LLM-driven jobspy call",
          "usage": "[options]"
        },
        {
          "name": "sourcing",
          "description": "Discover JobSource rows from recent SourceSeed URLs via headless browse + LLM",
          "usage": "[options]"
        },
        {
          "name": "listing",
          "description": "For each unprocessed JobSource, BFS the company site to find its job-listing page; insert a JobListSource row with a placeholder parserScript (`pipeline scripting` fills it in)",
          "usage": "[options]"
        },
        {
          "name": "scripting",
          "description": "For each unprocessed JobListSource, generate and validate a parser script (listLocations + searchJobs) and store it in JobListSource.parserScript",
          "usage": "[options]"
        }
      ]
    },
    {
      "name": "completion-script-dump",
      "description": "Generate Zsh completion script (writes __generated__/cli/_completion.zsh and prints to stdout)",
      "usage": "[options]"
    },
    {
      "name": "help-menu-dump",
      "description": "Dump the full command tree as JSON (writes __generated__/cli/help-menu.json and prints to stdout)",
      "usage": "[options]",
      "options": [
        {
          "flags": "--pretty",
          "description": "Pretty-print JSON (default)",
          "default": true
        },
        {
          "flags": "--no-pretty",
          "description": "Emit compact JSON",
          "negate": true
        }
      ]
    }
  ]
}
